{
  "id" : "com.packagearmor.PackageArmor",
  "runtime" : "org.freedesktop.Platform",
  "runtime-version" : "23.08",
  "runtime-commit" : "065c61a337f78034498ad18e2707dacb6852823b150488b9f5c95e1548f70ab5",
  "sdk" : "org.freedesktop.Sdk",
  "sdk-commit" : "f7bd662b000ec1a857b81d8fc158295493cc79b7286bae2c99ee357ab7ef17db",
  "command" : "package-armor",
  "modules" : [
    {
      "name" : "package-armor",
      "buildsystem" : "simple",
      "sources" : [
        {
          "dest" : "bundle",
          "path" : "../../build/linux/x64/release/bundle",
          "type" : "dir"
        },
        {
          "path" : "package-armor.sh",
          "type" : "file"
        },
        {
          "path" : "package-armor.desktop",
          "type" : "file"
        },
        {
          "path" : "package-armor-256.png",
          "type" : "file"
        }
      ],
      "build-commands" : [
        "mkdir -p /app/bin /app/share/applications /app/share/icons/hicolor/256x256/apps",
        "cp -r bundle/* /app/",
        "install -Dm755 package-armor.sh /app/bin/package-armor",
        "install -Dm644 package-armor.desktop /app/share/applications/com.packagearmor.PackageArmor.desktop",
        "install -Dm644 package-armor-256.png /app/share/icons/hicolor/256x256/apps/com.packagearmor.PackageArmor.png"
      ]
    }
  ],
  "finish-args" : [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=host",
    "--share=network",
    "--talk-name=org.freedesktop.Flatpak",
    "--system-talk-name=org.freedesktop.PackageKit"
  ],
  "source-date-epoch" : 1761376687
}