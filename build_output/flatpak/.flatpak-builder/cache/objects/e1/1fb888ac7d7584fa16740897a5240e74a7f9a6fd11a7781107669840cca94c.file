[Application]
name=com.packagearmor.PackageArmor
runtime=org.freedesktop.Platform/x86_64/23.08
sdk=org.freedesktop.Sdk/x86_64/23.08
command=package-armor

[Context]
shared=network;ipc;
sockets=x11;wayland;
devices=dri;
filesystems=host;

[Session Bus Policy]
org.freedesktop.Flatpak=talk

[System Bus Policy]
org.freedesktop.PackageKit=talk

[Extension com.packagearmor.PackageArmor.Debug]
directory=lib/debug
autodelete=true
no-autodownload=true

[Build]
built-extensions=com.packagearmor.PackageArmor.Debug;